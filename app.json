{
  "expo": {
    "name": "Kadou24h",
    "slug": "kadou24h-app",
    "version": "1.0.0",
    "newArchEnabled": false,
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kadou24h",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {}
    },
    "android": {
      "package": "com.ilmify.kadou24h",
      "versionCode": 4,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDummyKeyForGoogleMapsDevOnly000"
        }
      },
      "experimental": {
        "unstable_reactLegacyComponentNames": [
          "AIRMap",
          "AIRMapCallout",
          "AIRMapCalloutSubview",
          "AIRMapCircle",
          "AIRMapHeatmap",
          "AIRMapLocalTile",
          "AIRMapMarker",
          "AIRMapOverlay",
          "AIRMapPolygon",
          "AIRMapPolyline",
          "AIRMapUrlTile",
          "AIRMapWMSTile"
        ]
      },
      "adaptiveIcon": {
        "backgroundColor": "#8B5CF6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#8B5CF6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-localization",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kadou24h utilise votre position pour placer votre adresse de livraison sur la carte."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kadou24h a besoin de vos photos pour ajouter une photo de votre portail ou de votre produit.",
          "cameraPermission": "Kadou24h utilise l'appareil photo pour photographier votre portail ou votre produit."
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyDummyKeyForGoogleMapsDevOnly000"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": false,
            "enableMinifyInReleaseBuilds": false,
            "extraProguardRules": "-keep class com.google.android.gms.maps.** { *; }\n-dontwarn com.google.android.gms.maps.**\n-keep class com.google.maps.android.** { *; }\n-dontwarn com.google.maps.android.**\n-keep class com.rnmaps.** { *; }\n-dontwarn com.rnmaps.**"
          }
        }
      ],
      "expo-audio",
      [
        "expo-notifications",
        {
          "color": "#8B5CF6"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "14227e9f-e6c2-44b9-b673-decfcea8454c"
      }
    }
  }
}
