# API of kadou24h-server (npm run dev:local → port 7000)
# On a real phone use your PC's LAN IP, e.g. http://192.168.1.20:7000/api/v1
# Android emulator: http://10.0.2.2:7000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:7000/api/v1
# Optional — defaults to the API origin
# EXPO_PUBLIC_SOCKET_URL=http://localhost:7000
# Google sign-in button appears once this is set (native only)
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=
